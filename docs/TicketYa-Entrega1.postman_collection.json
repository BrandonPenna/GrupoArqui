{
  "info": {
    "_postman_id": "b7e91c40-8a1f-4e3a-9c01-ticketya2026",
    "name": "TicketYa - Sistema Completo (Entrega 1 + Entrega 2)",
    "description": "Colección completa de requests y datos de prueba (seed data) para probar los flujos de Entrega 1 y Entrega 2 (JWT, Preferencias NoSQL, Recomendaciones, Fila Virtual, Control de Acceso QR y Reportes) a través del API Gateway (http://localhost:8080).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Datos de Prueba (Seed Data)",
      "item": [
        {
          "name": "0.1 Crear Lugar 1 - Teatro del Fuerte (Tandil)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "org-1" },
              { "key": "X-User-Role", "value": "ORGANIZADOR" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Teatro del Fuerte\",\n  \"direccion\": \"Fuerte Independencia 360\",\n  \"ciudad\": \"Tandil\",\n  \"latitud\": -37.3287,\n  \"longitud\": -59.1367,\n  \"sectores\": [\n    {\n      \"nombre\": \"Platea Numerada\",\n      \"capacidad\": 100,\n      \"esNumerado\": true,\n      \"filas\": 10,\n      \"asientosPorFila\": 10\n    },\n    {\n      \"nombre\": \"Campo General\",\n      \"capacidad\": 200,\n      \"esNumerado\": false,\n      \"filas\": null,\n      \"asientosPorFila\": null\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/lugares",
              "host": ["{{baseUrl}}"],
              "path": ["api", "lugares"]
            }
          }
        },
        {
          "name": "0.2 Crear Evento 1 en Borrador - Los Piojos en Tandil",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "org-1" },
              { "key": "X-User-Role", "value": "ORGANIZADOR" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Recital Los Piojos en Tandil\",\n  \"descripcion\": \"Regreso histórico en vivo con todos los clásicos\",\n  \"tipo\": \"RECITAL\",\n  \"participantes\": [\"Los Piojos\", \"Ciro y Los Persas\"],\n  \"fechaHora\": \"2026-12-20T21:00:00\",\n  \"lugarId\": 1,\n  \"altaDemanda\": false,\n  \"precios\": [\n    { \"sectorId\": 1, \"precio\": 25000 },\n    { \"sectorId\": 2, \"precio\": 15000 }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/eventos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "eventos"]
            }
          }
        },
        {
          "name": "0.3 Publicar Evento 1",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "X-User-Id", "value": "org-1" },
              { "key": "X-User-Role", "value": "ORGANIZADOR" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/eventos/1/publicar",
              "host": ["{{baseUrl}}"],
              "path": ["api", "eventos", "1", "publicar"]
            }
          }
        }
      ]
    },
    {
      "name": "1. Catálogo y Búsqueda Multicriterio",
      "item": [
        {
          "name": "1.1 Buscar Eventos por Ciudad y Tipo (Orden Fecha)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/eventos?ciudad=Tandil&tipo=RECITAL&sort=fechaHora,asc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "eventos"],
              "query": [
                { "key": "ciudad", "value": "Tandil" },
                { "key": "tipo", "value": "RECITAL" },
                { "key": "sort", "value": "fechaHora,asc" }
              ]
            }
          }
        },
        {
          "name": "1.2 Buscar Eventos por Texto Libre y Relevancia",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/eventos?q=piojos&orden=relevancia",
              "host": ["{{baseUrl}}"],
              "path": ["api", "eventos"],
              "query": [
                { "key": "q", "value": "piojos" },
                { "key": "orden", "value": "relevancia" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Reservas Temporales, Concurrencia y Compra con QR",
      "item": [
        {
          "name": "2.1 Reservar Asiento Numerado (Fila 2, Asiento 3)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "cliente-1" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventoId\": 1,\n  \"sectorId\": 1,\n  \"asientos\": [\n    { \"fila\": 2, \"asiento\": 3 }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/reservas",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reservas"]
            }
          }
        },
        {
          "name": "2.2 Confirmar Compra Aprobada y Emitir QR",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "cliente-1" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reservaId\": 1,\n  \"medioPago\": \"TARJETA_CREDITO\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/compras/confirmar",
              "host": ["{{baseUrl}}"],
              "path": ["api", "compras", "confirmar"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Devoluciones y Cancelación de Evento",
      "item": [
        {
          "name": "3.1 Solicitar Devolución de Entrada (> 72 hs antes)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "cliente-1" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"motivo\": \"No puedo asistir en esa fecha\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/devoluciones/entradas/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "devoluciones", "entradas", "1"]
            }
          }
        },
        {
          "name": "3.2 Aprobar Devolución y Reintegrar (Admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Role", "value": "ADMIN" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"aprobar\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/devoluciones/1/resolver",
              "host": ["{{baseUrl}}"],
              "path": ["api", "devoluciones", "1", "resolver"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Entrega 2 - Autenticación JWT y Roles (US-23)",
      "item": [
        {
          "name": "4.1 Login JWT como Organizador",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"org-1\",\n  \"password\": \"1234\",\n  \"rol\": \"ORGANIZADOR\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Entrega 2 - Preferencias NoSQL, Recomendaciones y Avisos (Req. 10 y 11)",
      "item": [
        {
          "name": "5.1 Guardar Preferencias de Cliente en Colección NoSQL",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "cliente-1" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tiposEvento\": [\"RECITAL\", \"FESTIVAL\"],\n  \"artistasFavoritos\": [\"Los Piojos\"],\n  \"ciudad\": \"Tandil\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/preferencias",
              "host": ["{{baseUrl}}"],
              "path": ["api", "preferencias"]
            }
          }
        },
        {
          "name": "5.2 Obtener Eventos Recomendados",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Id", "value": "cliente-1" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/preferencias/recomendaciones",
              "host": ["{{baseUrl}}"],
              "path": ["api", "preferencias", "recomendaciones"]
            }
          }
        },
        {
          "name": "5.3 Consultar Bandeja de Notificaciones del Cliente",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Id", "value": "cliente-1" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/preferencias/notificaciones",
              "host": ["{{baseUrl}}"],
              "path": ["api", "preferencias", "notificaciones"]
            }
          }
        }
      ]
    },
    {
      "name": "6. Entrega 2 - Fila Virtual, Control de Acceso QR y Reportes (Req. 6, 8 y 12)",
      "item": [
        {
          "name": "6.1 Ingresar a Fila Virtual de Evento",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-Id", "value": "cliente-1" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/fila-virtual/eventos/1/ingresar",
              "host": ["{{baseUrl}}"],
              "path": ["api", "fila-virtual", "eventos", "1", "ingresar"]
            }
          }
        },
        {
          "name": "6.2 Validar Código QR en Control de Acceso",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "acceso-1" },
              { "key": "X-User-Role", "value": "PERSONAL_ACCESO" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventoId\": 1,\n  \"codigoQR\": \"REEMPLAZAR_POR_CODIGO_QR_DE_COMPRA\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/accesos/validar-qr",
              "host": ["{{baseUrl}}"],
              "path": ["api", "accesos", "validar-qr"]
            }
          }
        },
        {
          "name": "6.3 Consultar Reporte de Ocupación y Recaudación por Sector (Organizador)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Id", "value": "org-1" },
              { "key": "X-User-Role", "value": "ORGANIZADOR" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reportes/eventos/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reportes", "eventos", "1"]
            }
          }
        }
      ]
    }
  ]
}
