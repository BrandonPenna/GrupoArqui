            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Recital Los Piojos en Tandil\",\n  \"descripcion\": \"Regreso histórico en vivo con todos los clásicos\",\n  \"tipo\": \"RECITAL\",\n  \"participantes\": [\"Los Piojos\", \"Ciro y Los Persas\"],\n  \"fechaHora\": \"2026-12-20T21:00:00\",\n  \"lugarId\": 1,\n  \"precios\": [\n    { \"sectorId\": 1, \"precio\": 25000 },\n    { \"sectorId\": 2, \"precio\": 15000 }\n  ]\n}"
            },
            "url": {
