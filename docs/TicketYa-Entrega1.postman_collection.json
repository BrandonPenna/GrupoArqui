{
  "info": {
    "_postman_id": "b7e91c40-8a1f-4e3a-9c01-ticketya2026",
    "name": "TicketYa - Entrega 1 (Core del Sistema)",
    "description": "Colección de requests y datos de prueba (seed data) para probar todos los flujos de la Entrega 1 a través del API Gateway (http://localhost:8080).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Datos de Prueba (Seed Data)",
      "description": "Ejecutar en orden para poblar las bases con lugares, sectores (numerado y campo) y eventos publicados.",
      "item": [
        {
          "name": "0.1 Crear Lugar 1 - Teatro del Fuerte (Tandil)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "org-1" },
              { "key": "X-User-Role", "value": "ORGANIZADOR" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Teatro del Fuerte\",\n  \"direccion\": \"Fuerte Independencia 360\",\n  \"ciudad\": \"Tandil\",\n  \"latitud\": -37.3287,\n  \"longitud\": -59.1367,\n  \"sectores\": [\n    {\n      \"nombre\": \"Platea Numerada\",\n      \"capacidad\": 100,\n      \"esNumerado\": true,\n      \"filas\": 10,\n      \"asientosPorFila\": 10\n    },\n    {\n      \"nombre\": \"Campo General\",\n      \"capacidad\": 200,\n      \"esNumerado\": false,\n      \"filas\": null,\n      \"asientosPorFila\": null\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/lugares",
              "host": ["{{baseUrl}}"],
              "path": ["api", "lugares"]
            }
          }
        },
        {
